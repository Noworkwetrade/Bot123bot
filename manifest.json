{
  "manifest_version": 3,
  "name": "NWWT Pocket Option Signal Assistant",
  "version": "1.0.0",
  "description": "NWWT Pocket Option market scanner and candlestick signal assistant",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://pocketoption.com/*",
    "https://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NWWT Pocket Option"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
